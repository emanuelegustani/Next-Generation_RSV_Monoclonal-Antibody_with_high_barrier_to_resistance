from collections import Counter
from Bio import AlignIO

def calculate_entropy(alignment_file):
    """Calculate Shannon entropy per site from an aligned FASTA file."""
    # Step 1: Load the alignment
    alignment = AlignIO.read(alignment_file, "fasta")
    num_sequences = len(alignment)
    alignment_length = alignment.get_alignment_length()

    entropy_per_site = []

    # Step 2 & 3: Iterate over each site
    for i in range(alignment_length):
        column = alignment[:, i]  # Get all characters at position i
        counts = Counter(column)

        entropy = 0.0
        for count in counts.values():
            p_x = count / num_sequences
            if p_x > 0:  # Avoid log(0)
                entropy -= p_x * np.log2(p_x)

        entropy_per_site.append(entropy)

    # Step 4: Prepare output (e.g., list of tuples or DataFrame)
    positions = list(range(1, alignment_length + 1))  # 1-indexed
    result = list(zip(positions, entropy_per_site))
    return result

