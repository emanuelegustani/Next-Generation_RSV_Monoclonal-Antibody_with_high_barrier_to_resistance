# Function to add horizontal black text annotations for high entropy sites - SIMPLIFIED VERSION
def annotate_high_entropy(ax, df, fontsize=12):  # Increased fontsize
    """Annotate positions where entropy > threshold with simple black text (no bbox)."""
    high_entropy = df[df["Entropy"] > threshold]
    
    for _, row in high_entropy.iterrows():
        pos = row["Position"]
        entropy = row["Entropy"]
        
        # Add simple black text annotation at the top of the bar
        ax.text(pos, entropy, str(int(pos)),  # Display position number as integer
                ha='center', va='bottom',  # Center horizontally, place at bottom of text
                fontsize=fontsize,  # Increased from 9 to 12
                color='black',  # Black text
                fontweight='bold',
                rotation=0,  # Horizontal text (0 degrees)
                zorder=4)
        # Removed the bbox completely for cleaner look

