# Function to draw antibody regions WITHOUT BORDERS and BEHIND PLOTS
def draw_antibody_regions(ax, sites_dict, zorder_level=1):
    """Draw antibody binding regions on the given axis WITHOUT borders."""
    for name, info in sites_dict.items():
        color = info['color']
        alpha = info['alpha']
        
        if 'regions' in info:
            for region in info['regions']:
                if 'range' in region:
                    start, end = region['range']
                    # Remove edge/border with edgecolor='none'
                    ax.axvspan(start - 0.5, end + 0.5, alpha=alpha, color=color, 
                              edgecolor='none', linewidth=0, zorder=zorder_level)
        elif 'range' in info:
            start, end = info['range']
            ax.axvspan(start - 0.5, end + 0.5, alpha=alpha, color=color,
                      edgecolor='none', linewidth=0, zorder=zorder_level)
        elif 'positions' in info:
            for pos in info['positions']:
                ax.axvspan(pos - 0.5, pos + 0.5, alpha=alpha, color=color,
                          edgecolor='none', linewidth=0, zorder=zorder_level)

# Draw individual antibody sites on both axes (zorder=1)
